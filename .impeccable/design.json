  "narrative": {
    "northStar": "The Photo Workbench",
    "overview": "A restrained desktop photo workbench in Operate mode. The image carries the visual weight; a fixed inspector, file actions and persistent task status support adjustment without competing with it.\n\nThe shared Windows/macOS surface follows egui’s system light/dark preference. Neutral panels, familiar controls and a constant charcoal image surround keep comparison legible. This record describes the implemented native surface, not a web theme.",
    "keyCharacteristics": [
      "Image-led workspace with a separate scrolling inspector.",
      "Toolkit-native states and file dialogs.",
      "Visible comparison, mask and task state."
    ],
    "rules": [
      {
        "name": "The Neutral Surround Rule",
        "body": "Keep the image surround charcoal in both themes; use the toolkit selection accent for the active comparison.",
        "section": "colors"
      },
      {
        "name": "The Stable Workspace Rule",
        "body": "Keep file actions and task status visible while the inspector scrolls independently.",
        "section": "layout"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "Use panel boundaries and tonal contrast for the editing surface; retain toolkit tooltip and native dialog treatments.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do retain the shared desktop layout and system light/dark behavior.",
      "Do keep labels attached to sliders and expose numeric adjustment values.",
      "Do distinguish Original, Retouched and Skin mask with text as well as selection state."
    ],
    "donts": [
      "Don't style disabled adjustments as available before an image is ready or during export.",
      "Don't use the image surround as a decorative accent surface."
    ]
  }
